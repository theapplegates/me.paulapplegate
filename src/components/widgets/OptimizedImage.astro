---
import type { ImageMetadata } from "astro";
import { Image, Picture } from "astro:assets";
import type { ComponentProps } from "astro/types";

type Props = Omit<ComponentProps<typeof Picture>, "src"> & { src: string | ImageMetadata };

const { src, formats, fallbackFormat, pictureAttributes, ...options } = Astro.props;

const images = import.meta.glob<ImageMetadata>([
  "/src/assets/**/*.{jpeg,jpg,png,avif,tiff,gif,webp,svg}",
  "/public/**/*.{jpeg,jpg,png,avif,tiff,gif,webp,svg}",
  "/src/content/**/*.{jpeg,jpg,png,avif,tiff,gif,webp,svg}",
], { import: "default" });

let image = src;
if (typeof src === "string" && !/^https?:\/\//i.test(src)) {
  const path = "/" + src.replace(/^\/+/, "");
  const key = /^\/(public|src)\//.test(path) ? path : `/public${path}`;
  const load = images[key];
  if (!load) throw new Error(`Image "${src}" was not found. Check the path and filename in the post or template.`);
  image = await load();
}

const imageProps = { ...options, src: image } as ComponentProps<typeof Image>;
---

{formats?.length ? <Picture {...imageProps} {formats} {fallbackFormat} {pictureAttributes} /> : <Image {...imageProps} />}
