---
import { Search, X } from "@lucide/astro";
---
<dialog id="journal-search" class="journal-search-dialog" aria-labelledby="search-title">
  <h2 id="search-title" class="sr-only">Search Living Life</h2>
  <div class="journal-search-top"><Search size={20}/><label class="sr-only" for="journal-search-input">Search all fieldnotes</label><input id="journal-search-input" type="search" placeholder="What are you curious about?" autocomplete="off" spellcheck="false" aria-controls="journal-search-results" autofocus/><button id="journal-search-close" type="button" aria-label="Close search"><X size={17}/></button></div>
  <div class="journal-search-body"><p id="journal-search-status" role="status" aria-live="polite">Type a word or phrase to explore the journal.</p><ul id="journal-search-results" class="journal-search-results"></ul><button id="journal-search-retry" type="button" class="journal-search-retry" hidden>Try again</button></div>
  <div class="journal-search-footer"><span>↑ ↓ to explore · Enter to read · Esc to close</span><a href="https://orama.com" target="_blank" rel="noopener noreferrer">Powered by Orama ↗</a></div>
</dialog>
<script>
import { create, insertMultiple, search } from '@orama/orama';
import { appendHighlighted, createMatcher, resultPreview } from '@/lib/search-highlights';
type Entry = {id:string;title:string;description:string;tags:string;body:string;url:string;date:string;read:number};
const dialog=document.querySelector<HTMLDialogElement>('#journal-search')!;
const input=document.querySelector<HTMLInputElement>('#journal-search-input')!;
const results=document.querySelector<HTMLUListElement>('#journal-search-results')!;
const status=document.querySelector<HTMLElement>('#journal-search-status')!;
const retry=document.querySelector<HTMLButtonElement>('#journal-search-retry')!;
const makeDb=()=>create({schema:{id:'string',title:'string',description:'string',tags:'string',body:'string',url:'string',date:'string',read:'number'} as const});
let indexPromise: Promise<{db:ReturnType<typeof makeDb>,entries:Entry[]}> | undefined;
let requestId=0;
let opener:HTMLElement | null=null;
let previousOverflow='';
function getIndex(){
  if (!indexPromise) indexPromise=(async()=>{
    const response=await fetch('/search-index.json');
    if(!response.ok) throw new Error('Search index unavailable');
    const entries:Entry[]=await response.json();
    const db=makeDb();
    await insertMultiple(db,entries);
    return {db,entries};
  })().catch(error=>{indexPromise=undefined;throw error;});
  return indexPromise;
}
function render(entries:Entry[],term:string,count:number,tokenize:(text:string)=>string[]){
  const matches=createMatcher(term,tokenize);
  results.replaceChildren();
  status.textContent=term ? `${count} ${count===1?'fieldnote':'fieldnotes'} found${count>20?' · showing the first 20':''}` : 'A few fieldnotes to get you started';
  if(!entries.length){
    const li=document.createElement('li');li.className='journal-search-empty';li.textContent='No fieldnotes found. Try “morning”, “walk”, or “design”.';results.append(li);return;
  }
  for(const entry of entries){
    const li=document.createElement('li');const a=document.createElement('a');a.href=entry.url;a.className='journal-search-result';
    const title=document.createElement('strong');appendHighlighted(title,entry.title,matches(entry.title));
    const summary=document.createElement('span');const preview=term ? resultPreview(entry.description,entry.body,matches) : entry.description;appendHighlighted(summary,preview,matches(preview));
    const meta=document.createElement('small');appendHighlighted(meta,entry.tags,matches(entry.tags));meta.append(document.createTextNode(` · ${entry.read} min read`));
    a.append(title,summary,meta);li.append(a);results.append(li);
  }
}
async function runSearch(){
  const id=++requestId;const term=input.value.trim();retry.hidden=true;status.textContent='Searching the fieldnotes…';
  try {
    const {db,entries}=await getIndex();
    if(id!==requestId || !dialog.open) return;
    const tokenize=(text:string)=>db.tokenizer.tokenize(text);
    if(!term){render(entries.slice(0,4),'',entries.length,tokenize);return;}
    const match=await search(db,{term,properties:['title','description','tags','body'],boost:{title:4,tags:3,description:2},tolerance:term.length>3?1:0,limit:20,threshold:0});
    if(id!==requestId || !dialog.open) return;
    render(match.hits.map(hit=>hit.document as Entry),term,match.count,tokenize);
  } catch {
    if(id!==requestId || !dialog.open) return;
    results.replaceChildren();status.textContent='Search couldn’t load. Please try again, or browse the journal.';retry.hidden=false;
    const li=document.createElement('li');const a=document.createElement('a');a.href='/blog';a.textContent='Browse all fieldnotes →';a.className='journal-search-result';li.append(a);results.append(li);
  }
}
function openSearch(trigger?:HTMLElement){
  if(dialog.open){input.focus();return;}
  opener=trigger || document.activeElement as HTMLElement;
  previousOverflow=document.body.style.overflow;document.body.style.overflow='hidden';
  dialog.showModal();input.focus();void runSearch();
}
document.querySelectorAll<HTMLElement>('[data-search-open]').forEach(button=>button.addEventListener('click',()=>openSearch(button)));
document.querySelector('#journal-search-close')!.addEventListener('click',()=>dialog.close());
dialog.addEventListener('close',()=>{++requestId;document.body.style.overflow=previousOverflow;opener?.focus();});
dialog.addEventListener('click',event=>{const rect=dialog.getBoundingClientRect();if(event.target===dialog && (event.clientX<rect.left || event.clientX>rect.right || event.clientY<rect.top || event.clientY>rect.bottom))dialog.close();});
let timer:ReturnType<typeof setTimeout>;
input.addEventListener('input',()=>{++requestId;clearTimeout(timer);timer=setTimeout(()=>void runSearch(),100);});
retry.addEventListener('click',()=>void runSearch());
document.addEventListener('keydown',event=>{
  if((event.metaKey || event.ctrlKey) && event.key.toLowerCase()==='k'){event.preventDefault();openSearch();}
  if(!dialog.open || !['ArrowDown','ArrowUp'].includes(event.key))return;
  const links=[...results.querySelectorAll<HTMLAnchorElement>('a')];if(!links.length)return;
  event.preventDefault();const current=links.indexOf(document.activeElement as HTMLAnchorElement);
  const next=event.key==='ArrowDown'?(current+1)%links.length:current<=0?links.length-1:current-1;
  links[next].focus();
});
</script>
