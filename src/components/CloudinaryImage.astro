---
import { getResponsiveImage, type CloudinaryOptions } from "../lib/cloudinary";
import type { HTMLAttributes } from "astro/types";

interface Props extends CloudinaryOptions {
  publicId: string;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  pictureClass?: string;
  crops?: { media: string; width: number; height: number; widths: number[]; sizes: string }[];
}

const {
  publicId,
  alt,
  class: className,
  pictureClass,
  crops = [],
  loading = "lazy",
  fetchpriority = "auto",
  ...options
} = Astro.props;
const img = getResponsiveImage(publicId, { ...options, loading });
const sources = crops.map(({ media, ...crop }) => {
  const { srcset, sizes, width, height } = getResponsiveImage(publicId, { ...options, ...crop, loading });
  return { media, srcset, sizes, width, height };
});
const Wrapper = sources.length || pictureClass ? "picture" : Fragment;
// Forward Astro's scoped-style attributes to the image as well as its wrapper.
const scope = Object.fromEntries(
  Object.entries(Astro.props).filter(([key]) => key.startsWith("data-astro-cid-")),
);
---

<Wrapper class={pictureClass} {...scope}>
  {sources.map((source) => (
    <source {...source} />
  ))}
  <img
    {...(img as HTMLAttributes<"img">)}
    {...scope}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class={className}
  />
</Wrapper>

<style>
  picture {
    display: block;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
